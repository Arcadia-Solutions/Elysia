  "query": "select u.username, count(*) as \"files!\", sum(f.size)::bigint as \"bytes!\", to_char(max(f.created_at) at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') as \"last_upload!\" from files f join users u on u.id = f.uploaded_by_user_id where $1::text is null or f.created_at >= now() - $1::text::interval group by u.id, u.username order by 3 desc, u.id",
