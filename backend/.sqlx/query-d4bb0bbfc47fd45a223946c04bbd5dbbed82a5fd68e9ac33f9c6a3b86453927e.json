  "db_name": "PostgreSQL",
  "query": "select id, ext from files\n           where status = 'available' and id > $2\n             and exists (select 1 from unnest($1::checksum_algorithm[]) as algorithm\n                         where to_jsonb(files) ->> algorithm::text is null)\n           order by id limit $3",
